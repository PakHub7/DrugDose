<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.DrugDose" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorError">@color/error</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="actionBarStyle">@style/DrugDoseActionBar</item>
    </style>

    <style name="DrugDoseActionBar" parent="Widget.AppCompat.ActionBar">
        <item name="background">@color/primary</item>
        <item name="titleTextStyle">@style/DrugDoseActionBarTitle</item>
    </style>

    <style name="DrugDoseActionBarTitle" parent="TextAppearance.AppCompat.Widget.ActionBar.Title">
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- Tema per la notte (opzionale, eredita dal principale) -->
    <style name="Theme.DrugDose.Night" parent="Theme.DrugDose" />
</resources>
